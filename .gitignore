# Project Zomboid / local runtime output. Anchored to the repository root: on a
# case-insensitive file system, an unanchored Server/ also matches the mod's
# 42/media/lua/server/ folder and silently ignores its Lua files.
/Zomboid/
/Saves/
/Server/
/Workshop/
*.log
DebugLog*/
logs/
server-console*.txt

# Local and editor files
.claude/settings.local.json
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# Archives and generated release output
dist/
exports/
*.zip
*.7z
*.bak
*.tmp
workshop-staging/
build/

# Never commit private or game-derived material
.env
.env.*
*.env
!*.env.example
*.pem
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
extracted-game-assets/

# Test logs, decompiled game source, and research material belong in local
# folders outside the repository. These lines catch copies placed here anyway.
Logs/
decompiled/
research-source/
*.java
*.class
